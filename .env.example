# LifeOS environment variables. Copy to .env.local (never commit .env.local).
#
# Supabase dashboard -> Project Settings -> API (or the "Connect" dialog):
#   Project URL      -> NEXT_PUBLIC_SUPABASE_URL
#   Publishable key  -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  (a legacy "anon" key also works)
#
# These two values are public by design (they ship to the browser); Row Level Security protects
# the data. NEVER put a secret or service_role key here: LifeOS refuses to start if you do.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Optional: opening the dev server from another device (e.g. your phone) ---
# `npm run dev` already accepts this computer's own network address (http://192.168.x.x:3000).
# For other host names (e.g. my-pc.local or a tunnel), list them here, comma-separated,
# without http:// or a port. Development only; restart the dev server after changing it.
# LIFEOS_DEV_ORIGINS=my-pc.local

# --- Optional: browser tests against a real Supabase project (npm run test:e2e) ---
# Use dedicated TEST accounts, never your personal account. Leave unset to run the browser
# tests against the bundled local emulator instead.
# E2E_BASE_URL=http://localhost:3000
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
# E2E_USER2_EMAIL=
# E2E_USER2_PASSWORD=
